# DataStory AI — optional configuration.
# The app works fully without these. Never commit a real key.
# Locally: export the variables, or put them in .streamlit/secrets.toml.
# On Streamlit Community Cloud: paste them into the app's Secrets settings.

# Groq API key (free tier available at https://console.groq.com/keys).
# Enables LLM phrasing for the insights narrative and the dataset assistant.
GROQ_API_KEY=

# Optional: any Groq chat model ID. Default: llama-3.3-70b-versatile
GROQ_MODEL=
