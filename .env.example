# DataStory AI — optional configuration.
# The app works fully without any of these. Never commit a real key.
# Locally: copy to .env and export the variables, or put them in .streamlit/secrets.toml.
# On Streamlit Community Cloud: paste them into the app's Secrets settings.

# Optional LLM for narrative polishing and conversational assistant answers.
# Any ONE of these keys enables it (checked in this order).
DATASTORY_LLM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional overrides for any OpenAI-compatible endpoint.
DATASTORY_LLM_BASE_URL=
DATASTORY_LLM_MODEL=
